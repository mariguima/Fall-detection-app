<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_screen"
        android:scaleType="fitXY"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="24dp"
        android:paddingTop="48dp"
        android:paddingBottom="32dp">

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Connecting to the device"
            android:textColor="@color/accent_pink"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="96dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Cream card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="@color/card_cream"
            app:cardElevation="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="24dp"
                android:paddingTop="32dp"
                android:paddingBottom="32dp">

                <!-- Step 1 -->
                <TextView
                    android:id="@+id/tvStep1Number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1."
                    android:textColor="@color/accent_pink"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/tvStep1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Go to WiFi and connect to 'AutoConnectESP', the password is 'password'"
                    android:textColor="@color/text_dark"
                    android:textSize="15sp"
                    android:lineSpacingMultiplier="1.4"
                    android:layout_marginStart="12dp"
                    app:layout_constraintTop_toTopOf="@id/tvStep1Number"
                    app:layout_constraintStart_toEndOf="@id/tvStep1Number"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- Step 2 -->
                <TextView
                    android:id="@+id/tvStep2Number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2."
                    android:textColor="@color/accent_pink"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="24dp"
                    app:layout_constraintTop_toBottomOf="@id/tvStep1"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/tvStep2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="You will be redirected to another page, click on 'Configure Wifi'"
                    android:textColor="@color/text_dark"
                    android:textSize="15sp"
                    android:lineSpacingMultiplier="1.4"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="24dp"
                    app:layout_constraintTop_toBottomOf="@id/tvStep1"
                    app:layout_constraintStart_toEndOf="@id/tvStep2Number"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- Step 3 -->
                <TextView
                    android:id="@+id/tvStep3Number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3."
                    android:textColor="@color/accent_pink"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="24dp"
                    app:layout_constraintTop_toBottomOf="@id/tvStep2"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/tvStep3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Give the network name and password of your home, as well as the email you signed up in the app"
                    android:textColor="#5A5A5A"
                    android:textSize="15sp"
                    android:lineSpacingMultiplier="1.4"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="24dp"
                    app:layout_constraintTop_toBottomOf="@id/tvStep2"
                    app:layout_constraintStart_toEndOf="@id/tvStep3Number"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- Step 4 -->
                <TextView
                    android:id="@+id/tvStep4Number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4."
                    android:textColor="@color/accent_pink"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="24dp"
                    app:layout_constraintTop_toBottomOf="@id/tvStep3"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/tvStep4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Click on save and come back to the app"
                    android:textColor="@color/text_dark"
                    android:textSize="15sp"
                    android:lineSpacingMultiplier="1.4"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="24dp"
                    app:layout_constraintTop_toBottomOf="@id/tvStep3"
                    app:layout_constraintStart_toEndOf="@id/tvStep4Number"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- Next button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNext"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:text="Next"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:layout_marginTop="32dp"
                    app:backgroundTint="@color/button_teal"
                    app:cornerRadius="32dp"
                    app:layout_constraintTop_toBottomOf="@id/tvStep4"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>