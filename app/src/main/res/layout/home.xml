<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main page scrolls up to half a screen; the fall list has its own scroll area. -->
    <com.example.fall_detection_app.ui.home.HalfScreenNestedScrollView
        android:id="@+id/homeContentScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_screen"
        android:fillViewport="false">

        <LinearLayout
            android:id="@+id/homePageContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

        <!-- Top bar -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:background="@color/bgBottom"
            android:paddingHorizontal="24dp"
            android:elevation="4dp">

            <!-- Hamburger menu -->
            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_menu"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Menu"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <!-- Hello, Name -->
            <TextView
                android:id="@+id/tvHello"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hello,\nAmanda"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                android:layout_marginStart="12dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/btnMenu"/>


        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/analyticsContainerCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="26dp"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/card_cream"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
            android:paddingTop="12dp"
                android:paddingBottom="12dp">

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Your Analytics"
            android:textColor="@color/text_dark"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/periodToggleGroup"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:padding="1dp"
            android:background="@drawable/bg_period_toggle_outline"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:clipToOutline="true"
            android:layout_marginTop="12dp"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLast7Days"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:checkable="true"
                android:text="Last 7 days"
                android:textColor="@color/period_button_text"
                android:textSize="11sp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:backgroundTint="@color/period_button_tint"
                app:cornerRadius="20dp"
                app:strokeColor="@color/button_teal"
                app:strokeWidth="0dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLastMonth"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:checkable="true"
                android:text="Last month"
                android:textColor="@color/period_button_text"
                android:textSize="11sp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:backgroundTint="@color/period_button_tint"
                app:cornerRadius="20dp"
                app:strokeColor="@color/button_teal"
                app:strokeWidth="0dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLastYear"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:checkable="true"
                android:text="Last year"
                android:textColor="@color/period_button_text"
                android:textSize="11sp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:backgroundTint="@color/period_button_tint"
                app:cornerRadius="20dp"
                app:strokeColor="@color/button_teal"
                app:strokeWidth="0dp"/>

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/analyticsCards"
            android:layout_width="0dp"
            android:layout_height="92dp"
            android:layout_marginHorizontal="4dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/periodToggleGroup"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.cardview.widget.CardView
                android:id="@+id/cardConfirmedFalls"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="3dp"
                app:cardBackgroundColor="@color/analytics_tile"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:layout_constraintStart_toEndOf="@id/cardFalseAlarms"
                app:layout_constraintEnd_toStartOf="@id/cardTotalAlarms"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Confirmed falls"
                        android:textColor="@color/accent_pink"
                        android:textSize="11sp"/>

                    <TextView
                        android:id="@+id/tvWeeklyFalls"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="@color/accent_pink"
                        android:textSize="22sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvConfirmedFallsPercentage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="N/A"
                        android:textColor="@color/accent_pink"
                        android:textSize="10sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardFalseAlarms"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="5dp"
                app:cardBackgroundColor="@color/analytics_tile"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/cardConfirmedFalls"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="False alarms"
                        android:textColor="@color/button_teal"
                        android:textSize="11sp"/>

                    <TextView
                        android:id="@+id/tvFalseAlarms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="@color/button_teal"
                        android:textSize="22sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvFalseAlarmsPercentage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="N/A"
                        android:textColor="@color/button_teal"
                        android:textSize="10sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardTotalAlarms"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="5dp"
                app:cardBackgroundColor="@color/analytics_tile"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"

                app:layout_constraintStart_toEndOf="@id/cardConfirmedFalls"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Total alarms"
                        android:textColor="@color/text_dark"
                        android:textSize="11sp"/>

                    <TextView
                        android:id="@+id/tvTotalAlarms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="@color/text_dark"
                        android:textSize="22sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.example.fall_detection_app.ui.home.FallAnalyticsPieChartView
            android:id="@+id/fallAnalyticsPieChart"
            android:layout_width="184dp"
            android:layout_height="184dp"
            android:layout_marginTop="18dp"
            android:contentDescription="No reviewed fall alerts in this period"
            app:layout_constraintTop_toBottomOf="@id/analyticsCards"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <!-- Fall history cream card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="26dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/card_cream"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="20dp">


                <!-- Fall history title -->
                <TextView
                    android:id="@+id/tvFallHistory"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Fall history"
                    android:textColor="@color/text_dark"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- Divider -->
                <View
                    android:id="@+id/divider"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:background="@color/text_dark"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@id/tvFallHistory"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHistoryFilter"
                    android:layout_width="88dp"
                    android:layout_height="28dp"
                    android:layout_marginTop="10dp"
                    android:text="Filter"
                    android:textColor="@color/text_dark"
                    android:textSize="12sp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="@color/analytics_tile"
                    app:cornerRadius="8dp"
                    app:layout_constraintTop_toBottomOf="@id/divider"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- Empty state shown when no history items match the selected filter -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/emptyState"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/btnHistoryFilter"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <!-- Shield icon -->
                    <ImageView
                        android:id="@+id/ivEmptyIcon"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/ic_shield"
                        android:alpha="0.3"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintVertical_bias="0.4"/>

                    <TextView
                        android:id="@+id/tvEmptyTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="No falls detected yet"
                        android:textColor="@color/text_dark"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginTop="12dp"
                        app:layout_constraintTop_toBottomOf="@id/ivEmptyIcon"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <TextView
                        android:id="@+id/tvEmptySubtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Once the device picks up a fall, it'll show up here with the date and time."
                        android:textColor="@color/hint_gray"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.4"
                        android:layout_marginTop="8dp"
                        android:layout_marginHorizontal="16dp"
                        app:layout_constraintTop_toBottomOf="@id/tvEmptyTitle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Fall history list -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvFallHistory"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="12dp"
                    app:layout_constraintTop_toBottomOf="@id/btnHistoryFilter"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        </LinearLayout>
    </com.example.fall_detection_app.ui.home.HalfScreenNestedScrollView>

    <!-- Navigation drawer -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/navDrawer"
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/bgMid"
        android:paddingHorizontal="24dp"
        android:paddingTop="48dp"
        android:paddingBottom="32dp">

        <!-- My profile -->
        <TextView
            android:id="@+id/tvMyProfile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="My profile"
            android:textColor="@color/text_dark"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Divider -->
        <View
            android:id="@+id/drawerDivider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/text_dark"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvMyProfile"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Change profile -->
        <TextView
            android:id="@+id/tvChangeProfile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Change profile"
            android:textColor="@color/text_dark"
            android:textSize="15sp"
            android:paddingVertical="16dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/drawerDivider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Connect to device -->
        <TextView
            android:id="@+id/tvConnectDevice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Connect to the device"
            android:textColor="@color/text_dark"
            android:textSize="15sp"
            android:paddingVertical="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvChangeProfile"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Disconnect button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:text="Disconnect"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:backgroundTint="@color/accent_pink"
            app:cornerRadius="32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.drawerlayout.widget.DrawerLayout>
